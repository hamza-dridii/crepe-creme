---
import type { MenuItem } from "../lib/menu";
import { formatPrice } from "../lib/menu";
import { resolveImage } from "../lib/images";

interface Props {
  item: MenuItem;
  eager?: boolean;
}

const { item, eager = false } = Astro.props;
---

<article class="card">
  {/* Real photos go at item.image in public/ (square, ~800×800); missing ones show the placeholder. */}
  <button class="card__photo" type="button" aria-haspopup="dialog" aria-label={`Agrandir la photo : ${item.name}`} data-dish>
    <img
      class="card__img"
      src={resolveImage(item.image)}
      alt=""
      width="800"
      height="800"
      loading={eager ? "eager" : "lazy"}
      decoding="async"
    />
  </button>
  <div class="card__line">
    <h3 class="card__name">{item.name}</h3>
    <p class="card__price">{formatPrice(item.price)}</p>
  </div>
  {item.description && <p class="card__desc">{item.description}</p>}
</article>

<style>
  .card {
    /* Gap between the photo and its outline, like the inner line of the logo's oval; wider from tablets up. */
    --frame-gap: 3px;
    --frame-line: 1.5px;

    display: grid;
    align-content: start;
    gap: var(--space-2xs);
    min-width: 0;
  }

  /* The photo is the control: a leaf-shaped frame whose corners swap on hover; pressing it opens the dish view.
     It's inset by the outline's width so the outline lines up with the text below. */
  .card__photo {
    appearance: none;
    display: block;
    width: calc(100% - 2 * (var(--frame-gap) + var(--frame-line)));
    margin: calc(var(--frame-gap) + var(--frame-line));
    margin-block-end: calc(var(--space-sm) + var(--frame-gap));
    padding: 0;
    border: 0;
    overflow: hidden;
    isolation: isolate;
    border-radius: var(--radius-leaf);
    outline: var(--frame-line) solid var(--color-frame-line);
    outline-offset: var(--frame-gap);
    background: var(--color-image-bg);
    cursor: zoom-in;
    transition: border-radius var(--dur-long) var(--ease-out);
  }

  .card__photo:focus-visible {
    outline: 2px solid var(--color-focus);
  }

  .card__img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    transition: transform var(--dur-long) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .card__photo:hover {
      border-radius: var(--radius-leaf-flipped);
    }

    .card__photo:hover .card__img {
      transform: scale(1.04);
    }
  }

  /* Name left, price right; on narrow cards the price drops under the name. */
  .card__line {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 var(--space-sm);
    font-family: var(--font-display);
  }

  .card__name {
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-forest);
  }

  .card__price {
    font-size: var(--text-base);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    color: var(--color-price);
    white-space: nowrap;
  }

  .card__desc {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    font-size: var(--text-sm);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  @media (min-width: 40rem) {
    .card {
      --frame-gap: 5px;
    }

    .card__name,
    .card__price {
      font-size: var(--text-md);
    }
  }
</style>
